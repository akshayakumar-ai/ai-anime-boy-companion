# AI Anime Boy Virtual Companion - Environment Configuration

# Server Settings
PORT=5000
HOST=127.0.0.1
DEBUG=True

# LLM Providers (Optional - system falls back to built-in intelligent engine if not provided)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Google Gemini API Key (Optional)
GEMINI_API_KEY=

# Active LLM Provider: 'auto', 'groq', 'openai', 'gemini', or 'offline'
LLM_PROVIDER=auto

# Text-to-Speech Settings (Edge-TTS)
# Options: 'en-US-ChristopherNeural' (young male warm), 'en-US-GuyNeural' (casual), 'en-US-BrianNeural', 'ja-JP-KeitaNeural'
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Character Persona Settings
CHARACTER_NAME=Ren
CHARACTER_ROLE="Handsome, charming, and empathetic anime boy companion"
